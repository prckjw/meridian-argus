<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.prckjw.meridianargus</groupId>
        <artifactId>meridian-argus-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>meridian-argus-spring-boot-starter</artifactId>
    <name>MeridianArgus :: Spring Boot Starter</name>
    <description>Auto-configuration: registers the observability registry, pricing engine, and Micrometer exporter as beans with zero boilerplate.</description>

    <dependencies>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-metrics-micrometer</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-otel</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-metrics-sqlite</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-alerting</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.prckjw.meridianargus</groupId>
            <artifactId>meridian-argus-web-dashboard</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test-only: meridian-argus-otel's own opentelemetry-sdk test
                 dependency doesn't propagate here (test scope never does),
                 and MeridianArgusOtelAutoConfigurationTest needs a real
                 OpenTelemetry instance to register as a bean. Kept in sync
                 with meridian-argus-otel/pom.xml's opentelemetry.version. -->
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>1.64.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
