<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.prckjw.meridianargus</groupId>
    <artifactId>meridian-argus-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MeridianArgus</name>
    <description>
        Unified observability and cost governance for multi-provider LLM calls in Java.
        One consistent view across Azure OpenAI, OpenAI, AWS Bedrock, Google Vertex AI and Anthropic.
    </description>
    <url>https://github.com/prckjw/meridian-argus</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>prckjw</name>
            <url>https://github.com/prckjw</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/prckjw/meridian-argus</url>
        <connection>scm:git:https://github.com/prckjw/meridian-argus.git</connection>
        <developerConnection>scm:git:git@github.com:prckjw/meridian-argus.git</developerConnection>
    </scm>

    <modules>
        <module>meridian-argus-core</module>
        <module>meridian-argus-provider-openai</module>
        <module>meridian-argus-provider-azure-openai</module>
        <module>meridian-argus-provider-bedrock</module>
        <module>meridian-argus-provider-vertex</module>
        <module>meridian-argus-provider-anthropic</module>
        <module>meridian-argus-metrics-micrometer</module>
        <module>meridian-argus-metrics-sqlite</module>
        <module>meridian-argus-alerting</module>
        <module>meridian-argus-spring-boot-starter</module>
        <module>meridian-argus-examples/spring-boot-openai-demo</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>4.1.0</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- The following are all managed by the imported spring-boot-dependencies
                 BOM above (micrometer-core, slf4j-api, snakeyaml, junit-jupiter,
                 mockito-core). Deliberately not re-pinned here so they stay in
                 lockstep with whatever Spring Boot 4.1.x actually tests against,
                 instead of drifting out of sync (e.g. JUnit 5 vs. the JUnit 6
                 baseline Spring Boot 4 testing infra expects). -->

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-provider-openai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-provider-azure-openai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-provider-bedrock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-provider-vertex</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-provider-anthropic</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-metrics-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-metrics-sqlite</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-alerting</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.prckjw.meridianargus</groupId>
                <artifactId>meridian-argus-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- In <plugins> (not just <pluginManagement>) so every child module
             inherits and actually runs this: coverage instrumentation
             needs to be on by default, not something each module has to
             opt into individually. -->
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- Instruments test JVMs so coverage data is actually collected. -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- Per-module HTML/XML report, generated right after tests run. -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
